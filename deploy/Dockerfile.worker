# Eigen INGEST WORKER image — runs ONLY the corpus-ingest drain loop. This is the HEAVY image: it
# carries DOCLING (torch) for full-text PDF parsing. The API image (deploy/Dockerfile) stays lean and
# never loads docling. Same packages/env; different entrypoint (deploy/start-worker.sh → worker.main).
FROM python:3.13-slim

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade pip

# Light deps (image decode, PDF reader for attachments, numpy, R2) FIRST for layer caching.
RUN pip install --no-cache-dir Pillow PyMuPDF numpy boto3

# DOCLING — the full-text PDF-fallback parser (its heavy dep is torch; CPU-only wheels). Own cached
# layer so code pushes don't rebuild it.
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu docling

# Install the kernel (serve + postgres) and the TECH vertical + app code.
COPY packages packages
COPY apps apps
COPY deploy deploy
RUN pip install --no-cache-dir "./packages/kernel[serve,postgres]" ./packages/vertical_tech

ENV PYTHONPATH=/app/apps \
    EIGEN_ACTIVE_VERTICAL=tech \
    EIGEN_PROVIDER_MODE=live \
    EIGEN_GAP_HEALING=true \
    PORT=8000

EXPOSE 8000
CMD ["bash", "deploy/start-worker.sh"]
